@page
@model InmobiliariaAspCore.Pages.Seguridad.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <form method="POST"
          enctype="multipart/form-data"
          class="auth-card">
        @Html.AntiForgeryToken()

        <p class="auth-title">
            Login
        </p>

        <p class="auth-message">
            Ingresa con tu cuenta para acceder al sistema.
        </p>

        <label class="auth-label">
            <input class="auth-input"
                   type="email"
                   placeholder=""
                   required
                   asp-for="Usuario.Correo" />
            <span>
                Correo
            </span>
        </label>

        <label class="auth-label">
            <input class="auth-input"
                   type="password"
                   placeholder=""
                   required
                   asp-for="Usuario.ClaveHash" />
            <span>
                Clave
            </span>
        </label>

        <button type="submit"
                class="auth-submit"
                asp-page-handler="BtIngresar">
            Ingresar
        </button>

        <p class="auth-signin">
            No tienes cuenta?
            <a asp-area=""
               asp-page="/Seguridad/Register">
                Registrate
            </a>
        </p>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="auth-alert">
                @ViewData["Mensaje"]
            </div>
        }
    </form>
</div>