@page
@model InmobiliariaAspCore.Pages.Seguridad.LoginModel
@{
    ViewData["Title"] = "Login";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <h3>
                Login
            </h3>

            <div class="form-group">
                <label>
                    Correo
                </label>

                <div class="col-6">
                    <input id="inCorreo"
                           class="cts_forms form-control"
                           asp-for="@Model.Usuario!.Correo" />
                </div>
            </div>

            <div class="form-group">
                <label>
                    Clave
                </label>

                <div class="col-6">
                    <input id="inClave"
                           type="password"
                           class="cts_forms form-control"
                           asp-for="@Model.Usuario!.ClaveHash" />
                </div>
            </div>

            <br />

            <div>
                <input type="submit"
                       value="Ingresar"
                       class="btn btn-secondary"
                       asp-page-handler="BtIngresar" />

                <input type="submit"
                       value="Registrarse"
                       class="btn btn-secondary"
                       asp-page-handler="BtRegister" />
            </div>

            @if (ViewData.ContainsKey("Mensaje"))
            {
                <br />
                <div class="alert alert-danger">
                    @ViewData["Mensaje"]
                </div>
            }
        </form>
    </div>
</center>