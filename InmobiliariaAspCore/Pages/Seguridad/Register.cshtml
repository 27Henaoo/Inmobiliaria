@page
@model InmobiliariaAspCore.Pages.Seguridad.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <h3>
                Register
            </h3>

            <div class="form-group">
                <label>
                    Nombre
                </label>

                <div class="col-6">
                    <input id="inNombre"
                           class="cts_forms form-control"
                           asp-for="@Model.Usuario!.Nombre" />
                </div>
            </div>

            <div class="form-group">
                <label>
                    Correo
                </label>

                <div class="col-6">
                    <input id="inCorreo"
                           class="cts_forms form-control"
                           asp-for="@Model.Usuario!.Correo" />
                </div>
            </div>

            <div class="form-group">
                <label>
                    Clave
                </label>

                <div class="col-6">
                    <input id="inClave"
                           type="password"
                           class="cts_forms form-control"
                           asp-for="@Model.Usuario!.ClaveHash" />
                </div>
            </div>

            <div class="form-group">
                <label>
                    ConfirmarClave
                </label>

                <div class="col-6">
                    <input id="inConfirmarClave"
                           type="password"
                           class="cts_forms form-control"
                           asp-for="@Model.ClaveConfirmacion" />
                </div>
            </div>

            <br />

            <div>
                <input type="submit"
                       value="Registrar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRegistrar" />

                <input type="submit"
                       value="VolverLogin"
                       class="btn btn-secondary"
                       asp-page-handler="BtLogin" />
            </div>

            @if (ViewData.ContainsKey("Mensaje"))
            {
                <br />
                <div class="alert alert-danger">
                    @ViewData["Mensaje"]
                </div>
            }
        </form>
    </div>
</center>