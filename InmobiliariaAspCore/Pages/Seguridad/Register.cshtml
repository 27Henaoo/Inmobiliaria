@page
@model InmobiliariaAspCore.Pages.Seguridad.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <form method="POST"
          enctype="multipart/form-data"
          class="auth-card">
        @Html.AntiForgeryToken()

        <p class="auth-title">
            Register
        </p>

        <p class="auth-message">
            Crea tu cuenta para consultar informacion del sistema.
        </p>

        <label class="auth-label">
            <input class="auth-input"
                   type="text"
                   placeholder=""
                   required
                   asp-for="Usuario.Nombre" />
            <span>
                Nombre completo
            </span>
        </label>

        <label class="auth-label">
            <input class="auth-input"
                   type="email"
                   placeholder=""
                   required
                   asp-for="Usuario.Correo" />
            <span>
                Correo
            </span>
        </label>

        <label class="auth-label">
            <input class="auth-input"
                   type="password"
                   placeholder=""
                   required
                   asp-for="Usuario.ClaveHash" />
            <span>
                Clave
            </span>
        </label>

        <label class="auth-label">
            <input class="auth-input"
                   type="password"
                   placeholder=""
                   required
                   asp-for="ClaveConfirmacion" />
            <span>
                Confirmar clave
            </span>
        </label>

        <button type="submit"
                class="auth-submit"
                asp-page-handler="BtRegistrar">
            Registrar
        </button>

        <p class="auth-signin">
            Ya tienes cuenta?
            <a asp-area=""
               asp-page="/Seguridad/Login">
                Iniciar sesion
            </a>
        </p>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="auth-alert">
                @ViewData["Mensaje"]
            </div>
        }
    </form>
</div>