@page
@model PersonasModel
@{
    ViewData["Title"] = "Personas";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Personas</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Persona != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Persona == null)" />
            </div>

            @if (Model.Persona != null)
            {
                <input type="hidden"
                       asp-for="@Model.Persona!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Cedula
                        </label>
                        <div class="col-6">
                            <input id="inCedula"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Persona!.Cedula" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Persona!.Nombre" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Apellido
                        </label>
                        <div class="col-6">
                            <input id="inApellido"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Persona!.Apellido" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Genero
                        </label>
                        <div class="col-6">
                            <input id="inGenero"
                                   class="cts_forms form-control" @* se puede quitar este class form para que el char no 
                                   quede con un simbolo raro por defecto del navegador,
                                   lo dejo como tal para tener en cuenta que solo se debe ingresar una letra, M o F *@
                                   asp-for="@Model.Persona!.Genero" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Correo
                        </label>
                        <div class="col-6">
                            <input id="inCorreo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Persona!.Correo" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            FechaNacimiento
                        </label>
                        <div class="col-6">
                            <input id="inFechaNacimiento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Persona!.FechaNacimiento" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            FechaRegistro
                        </label>
                        <div class="col-6">
                            <input id="inFechaRegistro"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Persona!.FechaRegistro" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label">
                            EstadoCivil
                        </label>
                        <div class="col-lg-6">
                            <select id="inEstadoCivil"
                                    class="form-control"
                                    asp-for="@Model.Persona!.EstadoCivil"
                                    asp-items="@(new SelectList(Model.EstadosCiviles, "Id", "Nombre"))">
                            </select>
                        </div>
                    </div>
                   
                    <div class="form-group">
                        <label class="col-lg-4 control-label">
                            Nacionalidades
                        </label>
                        <div class="col-lg-6">
                            <select id="inNacionalidades"
                                    class="form-control"
                                    asp-for="@Model.Persona!.Nacionalidad"
                                    asp-items="@(new SelectList(Model.Nacionalidades, "Id", "Nombre"))">
                            </select>
                        </div>
                    </div>

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Persona != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar La Persona? Con Documento:
                            </h6>
                            <h6 align="left">
                                @Model.Persona!.Cedula
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Cedula
                        </th>
                        <th>
                            Nombre
                        </th>

                        <th>
                            Apellido
                        </th>

                        <th>
                            Genero
                        </th>

                        <th class="cl_hidden">
                            Correo
                        </th>

                        <th class="cl_hidden">
                            FechaNacimiento
                        </th>

                        <th class="cl_hidden">
                            FechaRegistro
                        </th>

                        <th class="cl_hidden">
                            EstadoCivil
                        </th>

                        <th class="cl_hidden">
                            Nacionalidad
                        </th>

                        <th class="cl_hidden">
                            Telefonos
                        </th>

                        <th class="cl_hidden">
                            Direcciones
                        </th>

                        <th class="cl_hidden">
                            ExpedientesLaborales
                        </th>


                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Cedula
                            </td>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                @elemento.Apellido
                            </td>
                            <td>
                                @elemento.Genero
                            </td>
                            <td>
                                @elemento.Correo
                            </td>
                            <td>
                                @elemento.FechaNacimiento.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @elemento.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>
                            
                            <td>
                                @if (elemento._EstadoCivil != null)
                                {
                                    @elemento._EstadoCivil.Nombre
                                }
                                else
                                {
                                    <span>Sin estado civil</span>
                                }
                            </td>

                            <td>
                                @if (elemento._Nacionalidad != null)
                                {
                                    @elemento._Nacionalidad.Nombre
                                }
                                else
                                {
                                    <span>Sin nacionalidad</span>
                                }
                            </td>

                            <td>
                                @if (elemento.Telefonos != null && elemento.Telefonos.Count > 0)
                                {
                                    foreach (var telefono in elemento.Telefonos)
                                    {
                                        <div>
                                            @telefono.Prefijo 
                                            @telefono.Numero
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>Sin telefonos</span>
                                }
                            </td>

                            <td>
                                @if (elemento.Direcciones != null && elemento.Direcciones.Count > 0)
                                {
                                    foreach (var direccion in elemento.Direcciones)
                                    {
                                        <div>
                                            @direccion.TipoVia 
                                            @direccion.Numero 
                                            @direccion.Complemento
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>Sin direcciones</span>
                                }
                            </td>

                            <td>
                                @if (elemento.ExpedientesLaborales != null && elemento.ExpedientesLaborales.Count > 0)
                                {
                                    foreach (var expediente in elemento.ExpedientesLaborales)
                                    {
                                        <div>
                                            <strong>Empresa:</strong> @expediente.NombreEmpresa
                                        </div>

                                        <div>
                                            <strong>Cargo:</strong> @expediente.Cargo
                                        </div>

                                        <div>
                                            <strong>Salario:</strong> @expediente.SalarioPagado.ToString("N0")
                                        </div>

                                        <div>
                                            <strong>Ingreso:</strong> @expediente.FechaIngreso.ToString("dd/MM/yyyy")
                                        </div>

                                        <div>
                                            <strong>Egreso:</strong> @expediente.FechaEgreso.ToString("dd/MM/yyyy")
                                        </div>

                                        <div>
                                            <strong>Desempeño:</strong> @expediente.Desempeno
                                        </div>

                                        <div>
                                            <strong>Motivo salida:</strong> @expediente.MotivoSalida
                                        </div>

                                        <hr />
                                    }
                                }
                                else
                                {
                                    <span>Sin expedientes laborales</span>
                                }
                            </td>
                            
                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>