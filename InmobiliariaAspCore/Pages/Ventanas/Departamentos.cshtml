@page
@model DepartamentosModel
@{
    ViewData["Title"] = "Departamentos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data"
              class="crud-page">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Departamentos</h3>
            </div>

            <div class="crud-toolbar">
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Departamento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Departamento == null)" />
            </div>

            @if (Model.Departamento != null)
            {
                <input type="hidden"
                       asp-for="@Model.Departamento!.Id" />

                <div class="crud-editor">
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Departamento!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado
                        </label>
                        <div class="col-6">
                            <input id="inEstado"
                                   asp-for="@Model.Departamento!.Estado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            FechaCreacion
                        </label>
                        <div class="col-6">
                            <input id="inFechaCreacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Departamento!.FechaCreacion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Poblacion
                        </label>
                        <div class="col-6">
                            <input id="inPoblacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Departamento!.Poblacion" />
                        </div>
                    </div>

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Departamento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Departamento?
                            </h6>
                            <h6 align="left">
                                @Model.Departamento!.Nombre
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Estado
                        </th>
                        <th>
                            FechaCreacion
                        </th>
                        <th>
                            Poblacion
                        </th>
                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                @elemento.Estado
                            </td>
                            <td>
                                @elemento.FechaCreacion
                            </td>
                            <td>
                                @elemento.Poblacion
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>