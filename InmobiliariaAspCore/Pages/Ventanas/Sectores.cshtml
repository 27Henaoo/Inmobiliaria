@page
@model SectoresModel
@{
    ViewData["Title"] = "Sectores";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Sectores</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Sector != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Sector == null)" />
            </div>

            @if (Model.Sector != null)
            {
                <input type="hidden"
                       asp-for="@Model.Sector!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Sector!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado
                        </label>
                        <div class="col-6">
                            <input id="inEstado"
                                   asp-for="@Model.Sector!.Estado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            FechaCreacion
                        </label>
                        <div class="col-6">
                            <input id="inFechaCreacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Sector!.FechaCreacion" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label">
                            Ciudad
                        </label>
                        <div class="col-lg-6">
                            <select id="inCiudad"
                                    class="form-control"
                                    asp-for="@Model.Sector!.Ciudad"
                                    asp-items="@(new SelectList(Model.Ciudades, "Id", "Nombre"))">
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>JefeSector</label>

                        <div class="col-lg-6">
                            <select id="inJefeSector"
                                    class="form-control"
                                    asp-for="@Model.JefeSectorSeleccionado">

                                <option value="0">
                                    Seleccione un jefe de sector
                                </option>

                                @foreach (var jefe in Model.JefesSectores)
                                {
                                    <option value="@jefe.Id">
                                        @jefe.Nombre @jefe.Apellido
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Sector != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Sector?
                            </h6>
                            <h6 align="left">
                                @Model.Sector!.Nombre
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Estado
                        </th>
                        <th>
                            FechaCreacion
                        </th>
                        <th>
                            Ciudad
                        </th>
                        <th class="cl_hidden">
                            JefeSector
                        </th>
                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                @elemento.Estado
                            </td>
                            <td>
                                @elemento.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @elemento._Ciudad?.Nombre
                            </td>
                            <td>
                                @if (elemento._JefeSector != null)
                                {
                                    @($"{elemento._JefeSector.Nombre} {elemento._JefeSector.Apellido}")
                                }
                                else
                                {
                                    <span>Sin jefe asignado</span>
                                }
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>