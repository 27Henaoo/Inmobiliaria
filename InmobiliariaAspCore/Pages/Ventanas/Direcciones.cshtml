@page
@model DireccionesModel
@{
    ViewData["Title"] = "Direcciones";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data"
              class="crud-page">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Direcciones</h3>
            </div>

            <div class="crud-toolbar">
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Direccion != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Direccion == null)" />
            </div>

            @if (Model.Direccion != null)
            {
                <input type="hidden"
                       asp-for="@Model.Direccion!.Id" />

                <div class="crud-editor">
                    <div class="form-group">
                        <label>
                            TipoVia
                        </label>
                        <div class="col-6">
                            <input id="inTipoVia"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Direccion!.TipoVia" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Numero
                        </label>
                        <div class="col-6">
                            <input id="inNumero"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Direccion!.Numero" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Complemento
                        </label>
                        <div class="col-6">
                            <input id="inComplemento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Direccion!.Complemento" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label">
                            Persona
                        </label>

                        <div class="col-lg-6">
                            <select id="inPersona"
                                    class="form-control"
                                    asp-for="@Model.Direccion!.Persona">

                                <option value="0">
                                    Seleccione una persona
                                </option>

                                @foreach (var persona in Model.Personas)
                                {
                                    <option value="@persona.Id">
                                        @persona.Nombre @persona.Apellido
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Direccion != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar la Direccion?
                            </h6>
                            <h6 align="left">
                                @Model.Direccion!.Numero
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            TipoVia
                        </th>
                        <th>
                            Numero
                        </th>

                        <th>
                            Complemento
                        </th>
                        
                        <th>
                            Persona
                        </th>

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.TipoVia
                            </td>
                            <td>
                                @elemento.Numero
                            </td>
                            <td>
                                @elemento.Complemento
                            </td>
                            <td>
                                @if (elemento._Persona != null)
                                {
                                    @($"{elemento._Persona.Nombre} {elemento._Persona.Apellido}")
                                }
                                else
                                {
                                    <span>Sin Persona Asignada</span>
                                }
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>