@page
@model BienesInmueblesModel
@{
    ViewData["Title"] = "BienesInmuebles";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data"
              class="crud-page">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>BienesInmuebles</h3>
            </div>

            <div class="crud-toolbar">
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />

                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.BienInmueble != null)" />

                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.BienInmueble == null)" />
            </div>

            @if (Model.BienInmueble != null)
            {
                <input type="hidden"
                       asp-for="@Model.BienInmueble!.Id" />

                <div class="crud-editor">
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.Nombre" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Descripcion
                        </label>
                        <div class="col-6">
                            <input id="inDescripcion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.Descripcion" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            FechaAdquisicion
                        </label>
                        <div class="col-6">
                            <input id="inFechaAdquisicion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.FechaAdquisicion" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            PrecioCompra
                        </label>
                        <div class="col-6">
                            <input id="inPrecioCompra"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.PrecioCompra" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            ValorActual
                        </label>
                        <div class="col-6">
                            <input id="inValorActual"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.ValorActual" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            MetrosCuadrados
                        </label>
                        <div class="col-6">
                            <input id="inMetrosCuadrados"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.MetrosCuadrados" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Direccion
                        </label>
                        <div class="col-6">
                            <input id="inDireccion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.Direccion" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            EstadoConservacion
                        </label>
                        <div class="col-6">
                            <input id="inEstadoConservacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.EstadoConservacion" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Estrato
                        </label>
                        <div class="col-6">
                            <input id="inEstrato"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.Estrato" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            NumeroHabitaciones
                        </label>
                        <div class="col-6">
                            <input id="inNumeroHabitaciones"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.NumeroHabitaciones" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            NumeroBanos
                        </label>
                        <div class="col-6">
                            <input id="inNumeroBanos"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.NumeroBanos" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            CodigoCUC
                        </label>
                        <div class="col-6">
                            <input id="inCodigoCUC"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.CodigoCUC" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            EncargosDeudas
                        </label>
                        <div class="col-6">
                            <input id="inEncargosDeudas"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BienInmueble!.EncargosDeudas" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label">
                            ExpedienteFinanciero
                        </label>

                        <div class="col-lg-6">
                            <select id="inExpedienteFinanciero"
                                    class="form-control"
                                    asp-for="@Model.BienInmueble!.ExpedienteFinanciero">

                                <option value="0">
                                    Seleccione un expediente financiero
                                </option>

                                @foreach (var expediente in Model.ExpedientesFinancieros)
                                {
                                    <option value="@expediente.Id">
                                        Expediente @expediente.Id
                                        @if (expediente._Persona != null)
                                        {
                                            @($" - {expediente._Persona.Nombre} {expediente._Persona.Apellido}")
                                        }
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.BienInmueble != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el BienInmueble?
                            </h6>

                            <h6 align="left">
                                @Model.BienInmueble!.Nombre
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />

                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>

                        <th>
                            Descripcion
                        </th>

                        <th>
                            FechaAdquisicion
                        </th>

                        <th>
                            PrecioCompra
                        </th>

                        <th>
                            ValorActual
                        </th>

                        <th>
                            MetrosCuadrados
                        </th>

                        <th>
                            Direccion
                        </th>

                        <th>
                            EstadoConservacion
                        </th>

                        <th>
                            Estrato
                        </th>

                        <th>
                            NumeroHabitaciones
                        </th>

                        <th>
                            NumeroBanos
                        </th>

                        <th>
                            CodigoCUC
                        </th>

                        <th>
                            EncargosDeudas
                        </th>

                        <th class="cl_hidden">
                            ExpedienteFinanciero
                        </th>

                        <th class="cl_hidden">
                            Cliente
                        </th>

                        <th class="cl_hidden">
                            CedulaCliente
                        </th>

                        <th class="cl_actions">
                            Accion
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre
                            </td>

                            <td>
                                @elemento.Descripcion
                            </td>

                            <td>
                                @elemento.FechaAdquisicion.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @elemento.PrecioCompra.ToString("N0")
                            </td>

                            <td>
                                @elemento.ValorActual.ToString("N0")
                            </td>

                            <td>
                                @elemento.MetrosCuadrados
                            </td>

                            <td>
                                @elemento.Direccion
                            </td>

                            <td>
                                @elemento.EstadoConservacion
                            </td>

                            <td>
                                @elemento.Estrato
                            </td>

                            <td>
                                @elemento.NumeroHabitaciones
                            </td>

                            <td>
                                @elemento.NumeroBanos
                            </td>

                            <td>
                                @elemento.CodigoCUC
                            </td>

                            <td>
                                @elemento.EncargosDeudas
                            </td>

                            <td>
                                @if (elemento._ExpedienteFinanciero != null)
                                {
                                    <span>Expediente @elemento._ExpedienteFinanciero.Id</span>
                                }
                                else
                                {
                                    <span>Sin expediente financiero</span>
                                }
                            </td>

                            <td>
                                @if (elemento._ExpedienteFinanciero != null && elemento._ExpedienteFinanciero._Persona != null)
                                {
                                    @($"{elemento._ExpedienteFinanciero._Persona.Nombre} {elemento._ExpedienteFinanciero._Persona.Apellido}")
                                }
                                else
                                {
                                    <span>Sin cliente</span>
                                }
                            </td>

                            <td>
                                @if (elemento._ExpedienteFinanciero != null && elemento._ExpedienteFinanciero._Persona != null)
                                {
                                    @elemento._ExpedienteFinanciero._Persona.Cedula
                                }
                                else
                                {
                                    <span>Sin cedula</span>
                                }
                            </td>

                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />

                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>