@page
@model CompradoresModel
@{
    ViewData["Title"] = "Compradores";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data"
              class="crud-page">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Compradores</h3>
            </div>

            <div class="crud-toolbar">
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />

                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Comprador != null)" />

                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Comprador == null)" />
            </div>

            @if (Model.Comprador != null)
            {
                <input type="hidden"
                       asp-for="@Model.Comprador!.Id" />

                <div class="crud-editor">
                    <div class="form-group">
                        <label>Cedula</label>
                        <div class="col-6">
                            <input id="inCedula"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Comprador!.Cedula" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Nombre</label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Comprador!.Nombre" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Apellido</label>
                        <div class="col-6">
                            <input id="inApellido"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Comprador!.Apellido" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Genero</label>
                        <div class="col-6">
                            <input id="inGenero"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Comprador!.Genero" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Correo</label>
                        <div class="col-6">
                            <input id="inCorreo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Comprador!.Correo" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>FechaNacimiento</label>
                        <div class="col-6">
                            <input id="inFechaNacimiento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Comprador!.FechaNacimiento" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>FechaRegistro</label>
                        <div class="col-6">
                            <input id="inFechaRegistro"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Comprador!.FechaRegistro" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label">EstadoCivil</label>
                        <div class="col-lg-6">
                            <select id="inEstadoCivil"
                                    class="form-control"
                                    asp-for="@Model.Comprador!.EstadoCivil"
                                    asp-items="@(new SelectList(Model.EstadosCiviles, "Id", "Nombre"))">
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-4 control-label">Nacionalidad</label>
                        <div class="col-lg-6">
                            <select id="inNacionalidad"
                                    class="form-control"
                                    asp-for="@Model.Comprador!.Nacionalidad"
                                    asp-items="@(new SelectList(Model.Nacionalidades, "Id", "Nombre"))">
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Comprador != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">Mensaje</h2>

                            <h6 align="left">
                                Desea borrar el Comprador? Con Documento:
                            </h6>

                            <h6 align="left">
                                @Model.Comprador!.Cedula
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />

                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Cedula
                        </th>

                        <th>
                            Nombre
                        </th>

                        <th>
                            Apellido
                        </th>

                        <th>
                            Genero
                        </th>

                        <th class="cl_hidden">
                            Correo
                        </th>

                        <th class="cl_hidden">
                            FechaNacimiento
                        </th>

                        <th class="cl_hidden">
                            FechaRegistro
                        </th>

                        <th class="cl_hidden">
                            EstadoCivil
                        </th>

                        <th class="cl_hidden">
                            Nacionalidad
                        </th>

                        <th class="cl_hidden">
                            Telefonos
                        </th>

                        <th class="cl_hidden">
                            Direcciones
                        </th>

                        <th class="cl_hidden">
                            ExpedientesLaborales
                        </th>

                        <th class="cl_hidden">
                            EmpleadosCompradores
                        </th>

                        <th class="cl_hidden">
                            Contratos
                        </th>

                        <th class="cl_actions">
                            Accion
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Cedula
                            </td>

                            <td>
                                @elemento.Nombre
                            </td>

                            <td>
                                @elemento.Apellido
                            </td>

                            <td>
                                @elemento.Genero
                            </td>

                            <td>
                                @elemento.Correo
                            </td>

                            <td>
                                @elemento.FechaNacimiento.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @elemento.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @if (elemento._EstadoCivil != null)
                                {
                                    @elemento._EstadoCivil.Nombre
                                }
                                else
                                {
                                    <span>Sin estado civil</span>
                                }
                            </td>

                            <td>
                                @if (elemento._Nacionalidad != null)
                                {
                                    @elemento._Nacionalidad.Nombre
                                }
                                else
                                {
                                    <span>Sin nacionalidad</span>
                                }
                            </td>

                            <td>
                                @if (elemento.Telefonos != null && elemento.Telefonos.Count > 0)
                                {
                                    foreach (var telefono in elemento.Telefonos)
                                    {
                                        <div>
                                            @telefono.Prefijo @telefono.Numero
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>Sin telefonos</span>
                                }
                            </td>

                            <td>
                                @if (elemento.Direcciones != null && elemento.Direcciones.Count > 0)
                                {
                                    foreach (var direccion in elemento.Direcciones)
                                    {
                                        <div>
                                            @direccion.TipoVia @direccion.Numero @direccion.Complemento
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>Sin direcciones</span>
                                }
                            </td>

                            <td>
                                @if (elemento.ExpedientesLaborales != null && elemento.ExpedientesLaborales.Count > 0)
                                {
                                    foreach (var expediente in elemento.ExpedientesLaborales)
                                    {
                                        <div>
                                            <strong>Empresa:</strong> @expediente.NombreEmpresa
                                        </div>

                                        <div>
                                            <strong>Cargo:</strong> @expediente.Cargo
                                        </div>

                                        <div>
                                            <strong>Salario:</strong> @expediente.SalarioPagado.ToString("N0")
                                        </div>

                                        <div>
                                            <strong>Ingreso:</strong> @expediente.FechaIngreso.ToString("dd/MM/yyyy")
                                        </div>

                                        <div>
                                            <strong>Egreso:</strong> @expediente.FechaEgreso.ToString("dd/MM/yyyy")
                                        </div>

                                        <div>
                                            <strong>Desempeno:</strong> @expediente.Desempeno
                                        </div>

                                        <div>
                                            <strong>Motivo salida:</strong> @expediente.MotivoSalida
                                        </div>

                                        <hr />
                                    }
                                }
                                else
                                {
                                    <span>Sin expedientes laborales</span>
                                }
                            </td>

                            <td>
                                @if (elemento.EmpleadosCompradores != null && elemento.EmpleadosCompradores.Count > 0)
                                {
                                    foreach (var empleadoComprador in elemento.EmpleadosCompradores)
                                    {
                                        <div>
                                            Fecha: @empleadoComprador.FechaAsesoramiento.ToString("dd/MM/yyyy")
                                        </div>

                                        @if (empleadoComprador._Empleado != null)
                                        {
                                            <div>
                                                Empleado: @empleadoComprador._Empleado.Nombre @empleadoComprador._Empleado.Apellido
                                            </div>
                                        }

                                        <hr />
                                    }
                                }
                                else
                                {
                                    <span>Sin empleados compradores</span>
                                }
                            </td>

                            <td>
                                @if (elemento.Contratos != null && elemento.Contratos.Count > 0)
                                {
                                    foreach (var contrato in elemento.Contratos)
                                    {
                                        <div>
                                            Contrato: @contrato.Id
                                        </div>

                                        <div>
                                            Fecha: @contrato.FechaContrato.ToString("dd/MM/yyyy")
                                        </div>

                                        <div>
                                            Finaliza: @contrato.FechaFinalizacion.ToString("dd/MM/yyyy")
                                        </div>

                                        <div>
                                            Valor: @contrato.PrecioAcordado.ToString("N0")
                                        </div>

                                        <div>
                                            Tipo: @contrato.ArriendoVenta
                                        </div>

                                        @if (contrato._Propiedad != null)
                                        {
                                            <div>
                                                Propiedad: @contrato._Propiedad.Id
                                            </div>
                                        }

                                        @if (contrato._Cliente != null)
                                        {
                                            <div>
                                                Cliente: @contrato._Cliente.Nombre @contrato._Cliente.Apellido
                                            </div>
                                        }

                                        @if (contrato._JefeSector != null)
                                        {
                                            <div>
                                                Jefe: @contrato._JefeSector.Nombre @contrato._JefeSector.Apellido
                                            </div>
                                        }

                                        <hr />
                                    }
                                }
                                else
                                {
                                    <span>Sin contratos</span>
                                }
                            </td>

                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />

                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>