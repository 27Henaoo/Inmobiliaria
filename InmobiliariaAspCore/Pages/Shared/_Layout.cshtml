@using Microsoft.AspNetCore.Http

@{
    var usuarioNombre = Context.Session.GetString("UsuarioNombre");
    var usuarioRolNombre = Context.Session.GetString("UsuarioRolNombre");

    var esAdmin = usuarioRolNombre == "Admin";
    var esEjecutivo = usuarioRolNombre == "Ejecutivo";

    //Si no hay sesion, se muestra el mismo menu del rol Guest (Inviatado por defecto de Roles en Usuario)
    var esInvitado = string.IsNullOrEmpty(usuarioNombre) || usuarioRolNombre == "Guest" || usuarioRolNombre == "Invitado";

